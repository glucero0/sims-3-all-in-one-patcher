<Window x:Class="Sims3ModernPatcher.ConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm before patching"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0B1220" Foreground="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Internet download and PC changes"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#7DD3FC"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="#CBD5E1"
                   LineHeight="20"
                   Margin="0,0,0,20"
                   Text="This patcher will download compatibility patches from the Internet and apply them on this PC. That includes changing files inside your Sims 3 installation (after creating backups), writing settings and cache files under your user profile, and optionally creating a desktop shortcut.&#10;&#10;No game files are changed until you click I Agree."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="I Decline"
                    Width="110" Height="34"
                    Margin="0,0,10,0"
                    Background="#1F2937"
                    Foreground="#F8FAFC"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    IsCancel="True"
                    Click="Decline_Click"/>
            <Button Content="I Agree"
                    Width="110" Height="34"
                    Background="#1D4ED8"
                    Foreground="White"
                    BorderThickness="0"
                    IsDefault="True"
                    Click="Agree_Click"/>
        </StackPanel>
    </Grid>
</Window>
